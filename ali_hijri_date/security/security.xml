<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_hijri_date" model="ir.module.category">
            <field name="name">Hijri Date</field>
            <field name="sequence">90</field>
        </record>

        <record id="res_groups_privilege_hijri_date" model="res.groups.privilege">
            <field name="name">Hijri Date</field>
            <field name="category_id" ref="module_category_hijri_date"/>
        </record>

        <!-- Standalone access group. Intentionally has NO users: the root
             "Hijri Converter" menu stays hidden until someone is granted this
             group. -->
        <record id="group_hijri_converter" model="res.groups">
            <field name="name">Hijri Date / Converter</field>
            <field name="privilege_id" ref="res_groups_privilege_hijri_date"/>
            <field name="comment">Access to the Hijri/Gregorian date converter menu.</field>
        </record>

    </data>
</odoo>
